{
  "name": "pulsecortex",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=25.9.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsx packages/daemon/src/main.ts",
    "pulsectl": "tsx packages/cli/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "protocol:generate": "codex app-server generate-ts --out packages/codex-driver/src/generated --experimental",
    "publish:packages": "pnpm publish -r --access public --provenance --no-git-checks",
    "start": "node packages/daemon/dist/main.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "better-sqlite3": "13.0.3",
    "commander": "14.0.2",
    "pino": "9.9.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
