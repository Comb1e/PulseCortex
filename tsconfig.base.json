{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@pulsecortex/domain": ["packages/domain/src/index.ts"],
      "@pulsecortex/config": ["packages/config/src/index.ts"],
      "@pulsecortex/persistence": ["packages/persistence/src/index.ts"],
      "@pulsecortex/codex-driver": ["packages/codex-driver/src/index.ts"],
      "@pulsecortex/feishu-adapter": ["packages/feishu-adapter/src/index.ts"],
      "@pulsecortex/core": ["packages/core/src/index.ts"],
      "@pulsecortex/installer": ["packages/installer/src/index.ts"]
    },
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
